      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.81.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.81.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MedicalApointment.Application/MedicalApointment.Application.csproj" />
    <ProjectReference Include="../MedicalApointment.Infrastructure/MedicalApointment.Infrastructure.csproj" />
    <ProjectReference Include="../MedicalApointment.Shared/MedicalApointment.Shared.csproj" />
  </ItemGroup>

</Project>
